                                                    <Path Data="M12,2 C8.1,2 5,5.1 5,9 C5,14.2 12,22 12,22 C12,22 19,14.2 19,9 C19,5.1 15.9,2 12,2 Z M12,11.5 A2.5,2.5 0 1 1 12.01,11.5 Z"
                                                          Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="WeatherCityText" Text="Konum aranıyor…" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Path x:Name="WeatherSmallIcon" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="2"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock x:Name="WeatherDescText" Text="" FontFamily="Segoe UI" FontSize="11" FontWeight="Regular" Foreground="{DynamicResource SecondaryTextBrush}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock x:Name="WeatherTempText" Text="--°C" FontFamily="Segoe UI" FontSize="25" FontWeight="Light" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Typography.NumeralAlignment="Tabular"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- ════ TRAY ════ -->
                                <Grid x:Name="TrayPanel" Visibility="Collapsed" Opacity="0" Margin="0,0,0,14">
                                    <Border x:Name="TrayDropZone" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource TabBarBorderBrush}" BorderThickness="1" CornerRadius="18" AllowDrop="True"
                                            DragEnter="Tray_DragEnter" DragOver="Tray_DragEnter" DragLeave="Tray_DragLeave" Drop="Tray_Drop">
                                        <Grid AllowDrop="True">
                                            <Rectangle RadiusX="14" RadiusY="14" Margin="8" StrokeThickness="1.2" StrokeDashArray="3 3"
                                                       Fill="Transparent" Opacity="0.4" IsHitTestVisible="False"
                                                       Stroke="{DynamicResource SecondaryTextBrush}"/>

                                            <StackPanel x:Name="TrayEmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <Path Data="M19,3H4.99c-1.11,0 -1.98,0.89 -1.98,2L3,19c0,1.1 0.88,2 1.99,2H19c1.1,0 2,-0.9 2,-2V5c0,-1.11 -0.9,-2 -2,-2zM19,15h-4c0,1.66 -1.35,3 -3,3s-3,-1.34 -3,-3H4.99V5H19v10z" Fill="{DynamicResource TertiaryTextBrush}" Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Dosyaları buraya sürükle" FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                <TextBlock Text="Tıkla: aç  ·  Sağ tık: kaldır" FontFamily="Segoe UI" FontSize="10.5" FontWeight="Regular" Foreground="{DynamicResource TertiaryTextBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="16,14,10,10" AllowDrop="True">
                                                <ScrollViewer.Resources>
                                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                                                </ScrollViewer.Resources>
                                                <WrapPanel x:Name="TrayItemsPanel" AllowDrop="True"/>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- ════ AYARLAR ════ -->
                                <Grid x:Name="SettingsPanel" Visibility="Collapsed" Opacity="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="116"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Kategori menüsü -->
                                    <StackPanel Grid.Column="0" Margin="0,2,0,0">
                                        <Button x:Name="SettingsNav0Btn" Style="{StaticResource NavBtn}" Height="34" Margin="0,0,0,4" Tag="0" Click="SettingsNav_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M3,17v2h6v-2H3zM3,5v2h10V5H3zM13,21v-2h8v-2h-8v-2h-2v6h2zM7,9v2H3v2h4v2h2V9H7zM21,13v-2H11v2h10zM15,9h2V7h4V5h-4V3h-2v6z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                          Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                                                <TextBlock Text="Genel" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="SettingsNav1Btn" Style="{StaticResource NavBtn}" Height="34" Margin="0,0,0,4" Tag="1" Click="SettingsNav_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                          Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                                                <TextBlock Text="Widget'lar" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="SettingsNav2Btn" Style="{StaticResource NavBtn}" Height="34" Margin="0,0,0,4" Tag="2" Click="SettingsNav_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zm0,18V4c4.41,0 8,3.59 8,8s-3.59,8 -8,8z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                          Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                                                <TextBlock Text="Görünüm" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <Border Grid.Column="1" Width="1" HorizontalAlignment="Left" Margin="0,4,0,4"
                                            Background="{DynamicResource TabBarBorderBrush}"/>

                                    <!-- ══ Sayfa: GENEL ══ -->
                                    <ScrollViewer x:Name="SettingsPageGeneral" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0" Focusable="False">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                                        </ScrollViewer.Resources>
                                        <StackPanel Margin="0,2,0,0">
                                            <TextBlock Text="Genel" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="2,0,0,10"/>
                                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource TabBarBorderBrush}" BorderThickness="1" CornerRadius="14">
                                                <StackPanel>
                                                    <Grid Margin="14,0" MinHeight="54">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,8,10,8">
                                                            <TextBlock Text="Mod" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                                            <TextBlock Text="Adanın ekrandaki duruşu" FontFamily="Segoe UI" FontSize="10" FontWeight="Regular" Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button x:Name="ModeFloatingBtn" Style="{StaticResource OptBtn}" Tag="Floating" Click="ModeButton_Click" Margin="0,0,5,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Path Data="M5,7 H19 V15 H5 Z" Fill="{DynamicResource PrimaryTextBrush}" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Yüzen" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button x:Name="ModeStickyBtn" Style="{StaticResource OptBtn}" Tag="Sticky" Click="ModeButton_Click" >
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Path Data="M4,2 H20 V11 H4 Z M4,14 H20 V16 H4 Z" Fill="{DynamicResource PrimaryTextBrush}" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Yapışkan" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Border Height="1" Background="{DynamicResource TabBarBorderBrush}" Margin="14,0"/>
                                                    <Grid Margin="14,0" MinHeight="54">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,8,10,8">
                                                            <TextBlock Text="Monitör" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                                            <TextBlock Text="Adanın gösterileceği ekran" FontFamily="Segoe UI" FontSize="10" FontWeight="Regular" Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <StackPanel x:Name="MonitorButtonsPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <Border Height="1" Background="{DynamicResource TabBarBorderBrush}" Margin="14,0"/>
                                                    <Grid Margin="14,0" MinHeight="54">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,8,10,8">
                                                            <TextBlock Text="Gizle / Göster" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                                            <TextBlock Text="Kutuya tıkla, tuşlara bas" FontFamily="Segoe UI" FontSize="10" FontWeight="Regular" Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <Border x:Name="HotkeyField" Grid.Column="1" VerticalAlignment="Center"
                                                        Background="{DynamicResource TabBarBgBrush}" BorderBrush="{DynamicResource TabBarBorderBrush}"
                                                        BorderThickness="1" CornerRadius="9" Padding="12,6" MinWidth="150" Cursor="Hand"
                                                        MouseLeftButtonDown="HotkeyField_MouseLeftButtonDown">
                                                            <TextBlock x:Name="HotkeyText" Text="Ctrl + Shift + H"
                                                               Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI"
                                                               FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- ══ Sayfa: WIDGET'LAR ══ -->
                                    <ScrollViewer x:Name="SettingsPageWidgets" Grid.Column="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0" Focusable="False">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                                        </ScrollViewer.Resources>
                                        <StackPanel Margin="0,2,0,0">
                                            <Grid Margin="2,0,0,2">
                                                <TextBlock Text="Widget'lar" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                <Button Content="Sıfırla" Style="{StaticResource GhostBtn}" Height="24" FontSize="10.5"
                                                        HorizontalAlignment="Right" Click="LayoutReset_Click"/>
                                            </Grid>
                                            <TextBlock Text="Bir kutuya tıkla: widget seç, taşı ya da kaldır" FontFamily="Segoe UI" FontSize="10" FontWeight="Regular" Foreground="{DynamicResource TertiaryTextBrush}" Margin="2,0,0,8"/>

                                            <UniformGrid Rows="2" Columns="2" Margin="-3,0,-3,10">
                                                <Button x:Name="LayoutCell0Btn" Style="{StaticResource TileBtn}" Height="56" Margin="3" Click="LayoutCell_Click"/>
                                                <Button x:Name="LayoutCell1Btn" Style="{StaticResource TileBtn}" Height="56" Margin="3" Click="LayoutCell_Click"/>
                                                <Button x:Name="LayoutCell2Btn" Style="{StaticResource TileBtn}" Height="56" Margin="3" Click="LayoutCell_Click"/>
                                                <Button x:Name="LayoutCell3Btn" Style="{StaticResource TileBtn}" Height="56" Margin="3" Click="LayoutCell_Click"/>
                                            </UniformGrid>

                                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource TabBarBorderBrush}" BorderThickness="1" CornerRadius="14">
                                                <Grid Margin="14,0" MinHeight="54">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,8,10,8">
                                                        <TextBlock Text="Hava durumu şehri" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                                        <TextBlock Text="Boş bırakırsan konum otomatik bulunur" FontFamily="Segoe UI" FontSize="10" FontWeight="Regular" Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" VerticalAlignment="Center" Width="120"
                                                        Background="{DynamicResource TabBarBgBrush}" BorderBrush="{DynamicResource TabBarBorderBrush}"
                                                        BorderThickness="1" CornerRadius="9" Padding="10,5">
                                                        <TextBox x:Name="WeatherCityInput" Background="Transparent" BorderThickness="0"
                                                             Foreground="{DynamicResource PrimaryTextBrush}" CaretBrush="{DynamicResource PrimaryTextBrush}"
                                                             FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold" TextAlignment="Center"
                                                             MaxLength="40" KeyDown="WeatherCityInput_KeyDown" LostFocus="WeatherCityInput_LostFocus"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- ══ Sayfa: GÖRÜNÜM ══ -->
                                    <ScrollViewer x:Name="SettingsPageTheme" Grid.Column="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0" Focusable="False">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                                        </ScrollViewer.Resources>
                                        <StackPanel Margin="0,2,0,0">
                                            <TextBlock Text="Görünüm" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="2,0,0,2"/>
                                            <TextBlock Text="Adanın renk teması" FontFamily="Segoe UI" FontSize="10" FontWeight="Regular" Foreground="{DynamicResource TertiaryTextBrush}" Margin="2,0,0,10"/>
                                            <UniformGrid Rows="2" Columns="3" HorizontalAlignment="Left" Margin="-3,0,0,0">

                                                <Button x:Name="ThemeLightBtn" Style="{StaticResource ThemeBtn}" Tag="Light" Click="ThemeButton_Click" Margin="3">
                                                    <StackPanel>
                                                        <Border Width="58" Height="40" CornerRadius="9" Background="#F5F5F7" BorderBrush="#1A000000" BorderThickness="1">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Border Width="26" Height="3" CornerRadius="1.5" Background="#202020" Margin="0,0,0,3"/>
                                                                <Border Width="16" Height="2.5" CornerRadius="1.25" Background="#606060" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="Açık" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button x:Name="ThemeDarkBtn" Style="{StaticResource ThemeBtn}" Tag="Dark" Click="ThemeButton_Click" Margin="3">
                                                    <StackPanel>
                                                        <Border Width="58" Height="40" CornerRadius="9" Background="#0A0A0C" BorderBrush="#2A2A2C" BorderThickness="1">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Border Width="26" Height="3" CornerRadius="1.5" Background="#F0F0F2" Margin="0,0,0,3"/>
                                                                <Border Width="16" Height="2.5" CornerRadius="1.25" Background="#7A7A80" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="Koyu" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button x:Name="ThemeDarkBlueBtn" Style="{StaticResource ThemeBtn}" Tag="DarkBlue" Click="ThemeButton_Click" Margin="3">
                                                    <StackPanel>
                                                        <Border Width="58" Height="40" CornerRadius="9" Background="#0F1E3A" BorderBrush="#3064A0FF" BorderThickness="1">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Border Width="26" Height="3" CornerRadius="1.5" Background="#E8F0FF" Margin="0,0,0,3"/>
                                                                <Border Width="16" Height="2.5" CornerRadius="1.25" Background="#7A8EB0" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="K. Mavi" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button x:Name="ThemePurpleBtn" Style="{StaticResource ThemeBtn}" Tag="Purple" Click="ThemeButton_Click" Margin="3">
                                                    <StackPanel>
                                                        <Border Width="58" Height="40" CornerRadius="9" Background="#1A0A2E" BorderBrush="#30A855F7" BorderThickness="1">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Border Width="26" Height="3" CornerRadius="1.5" Background="#EBE0FF" Margin="0,0,0,3"/>
                                                                <Border Width="16" Height="2.5" CornerRadius="1.25" Background="#9A80C8" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="Mor" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button x:Name="ThemeGreenBtn" Style="{StaticResource ThemeBtn}" Tag="Green" Click="ThemeButton_Click" Margin="3">
                                                    <StackPanel>
                                                        <Border Width="58" Height="40" CornerRadius="9" Background="#082214" BorderBrush="#3010B981" BorderThickness="1">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Border Width="26" Height="3" CornerRadius="1.5" Background="#E0FFE8" Margin="0,0,0,3"/>
                                                                <Border Width="16" Height="2.5" CornerRadius="1.25" Background="#7AB88E" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="Yeşil" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button x:Name="ThemeRedBtn" Style="{StaticResource ThemeBtn}" Tag="Red" Click="ThemeButton_Click" Margin="3">
                                                    <StackPanel>
                                                        <Border Width="58" Height="40" CornerRadius="9" Background="#22080A" BorderBrush="#30EF4444" BorderThickness="1">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Border Width="26" Height="3" CornerRadius="1.5" Background="#FFE0E4" Margin="0,0,0,3"/>
                                                                <Border Width="16" Height="2.5" CornerRadius="1.25" Background="#C08088" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="Kırmızı" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                            </UniformGrid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>

                            </Grid>
                        </Grid>

                    </Grid>
                </Grid>
            </Border>

            <!-- ═══════════ YAPIŞKAN MOD: ÇENTİK OMUZLARI ═══════════ -->
            <Path x:Name="NotchEarLeft"
                  Data="M 0,0 L 16.5,0 L 16.5,16 L 16,16 A 16,16 0 0 0 0,0 Z"
                  Width="16.5" Height="16" Stretch="None"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="-16,0,0,0"
                  Fill="#FF070707"
                  IsHitTestVisible="False"
                  SnapsToDevicePixels="False"
                  RenderTransformOrigin="1,0"
                  Visibility="Collapsed">
                <Path.RenderTransform>
                    <ScaleTransform x:Name="NotchEarLeftScale" ScaleX="0" ScaleY="0"/>
                </Path.RenderTransform>
            </Path>
            <Path x:Name="NotchEarRight"
                  Data="M 16.5,0 L 0,0 L 0,16 L 0.5,16 A 16,16 0 0 1 16.5,0 Z"
                  Width="16.5" Height="16" Stretch="None"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="0,0,-16,0"
                  Fill="#FF070707"
                  IsHitTestVisible="False"
                  SnapsToDevicePixels="False"
                  RenderTransformOrigin="0,0"
                  Visibility="Collapsed">
                <Path.RenderTransform>
                    <ScaleTransform x:Name="NotchEarRightScale" ScaleX="0" ScaleY="0"/>
                </Path.RenderTransform>
            </Path>
        </Grid>
    </Grid>

</Window>